# ptt-dictate configuration. Copy to %LOCALAPPDATA%\ptt-dictate\config.
# Values are read each time the daemon starts; no rebuild is needed.
# Key names match the shared schema used by the Mac build.

# RightCtrl is the Windows-friendly default. Also supported: RightWin, RightAlt, F13-F24.
HOTKEY=RightCtrl

# builtin prefers an active non-Bluetooth capture endpoint. Alternatively use an
# exact endpoint ID printed by: .\ptt.ps1 devices
INPUT_DEVICE=builtin

MAX_RECORD_SECONDS=2700
MICCHECK_SECONDS=5
AUTO_PASTE=true
PREPROCESS=true
FFMPEG_PATH=ffmpeg.exe

# whisper.cpp paths. setup.ps1 fills these in when it installs the runtime.
WHISPER_CLI=%LOCALAPPDATA%\ptt-dictate\whisper\whisper-cli.exe
WHISPER_MODEL=%LOCALAPPDATA%\ptt-dictate\models\ggml-large-v3-turbo-q5_0.bin
VAD_MODEL=%LOCALAPPDATA%\ptt-dictate\models\ggml-silero-v6.2.0.bin
WHISPER_TIMEOUT_SECONDS=600
# Decode language: en, es, ... See whisper.cpp for the full list of supported codes.
LANGUAGE=en
WHISPER_THREADS=0
WHISPER_PROMPT=Wispr Flow, ptt-dictate, Codex, Next.js, TypeScript, PowerShell, Windows, whisper.cpp.
# Whisper mode: quiet-voice dictation. Lowers the VAD threshold so soft speech is not
# gated out. Toggle this on if you tend to dictate at a whisper.
WHISPER_MODE=false

# Semicolon-delimited regex=>replacement pairs. Invalid regexes are logged and skipped.
GLOSSARY=\bwispr\s*flow\b=>Wispr Flow;\bnext\s*(?:\.\s*)?js\b=>Next.js;\btype\s*script\b=>TypeScript;\bpower\s*shell\b=>PowerShell;\bwhisper\s*(?:\.\s*)?cpp\b=>whisper.cpp;\bcodex\b=>Codex

# Optional sound WAV overrides. Blank uses ptt-dictate's distinct built-in chimes.
START_SOUND=
STOP_SOUND=
DONE_SOUND=

# License. Get your key from your nesso.tech dashboard. Recording refuses to start
# without an active license. Leave this blank and add a file named ".dev" next to this
# config (same folder) to run unlicensed on a development machine.
LICENSE_KEY=
LICENSE_URL=https://nesso.tech/api/license

# AI polish: after transcription, a licensed install can send the transcript to the
# nesso.tech proxy for a rewrite before it is pasted. Any error, timeout, or untrustworthy
# result pastes the raw transcript instead, so dictation never blocks or loses your words.
# Say "verbatim" as the first word of a dictation to always skip polishing for that clip.
POLISH_PROXY_URL=https://nesso.tech/api/polish
# What a dictation delivers when the foreground app matches neither POLISH_APPS nor
# PRO_APPS: summarize | professional | normal.
DEFAULT_MODE=summarize
# Standing instruction for how the writing should always sound, for example "warm and
# direct" or "formal, never casual". Applied to every rewrite. Blank disables this.
STYLE=
# Foreground process names (comma-separated, case-insensitive, matched as a substring)
# that always get the professional cleanup rewrite.
PRO_APPS=OUTLOOK,Teams,slack,discord,WhatsApp
# Foreground process names that always get the AI prompt-expansion rewrite.
POLISH_APPS=WindowsTerminal,Code,Cursor,Warp,Claude,Codex
# Dictations shorter than this many words paste raw. A rewrite round trip on a
# one-liner is pure latency with nothing worth rewriting.
POLISH_MIN_WORDS=12

# Privacy mode: your words are never written to disk. 0 keeps an encrypted
# history instead, protected by a key held in Windows DPAPI for this user.
PRIVACY_MODE=1
# Anything retained is deleted after this many days. 0 keeps nothing.
HISTORY_DAYS=7
# Keep the audio of the last dictation on disk. Off by default.
KEEP_LAST_CLIP=0
